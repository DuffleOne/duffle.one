**/node_modules/*
**/build/*
**/.vite/*
**/.wrangler/
.DS_Store
.dev.vars
.env
.env.local
.env.*.local

# Full-size jellycat photos (2GB+) — uploaded to S3 separately via publish.sh
src/public/img/jellycats/*.jpg

# Raw camera drop-zone for new gallery shots (processed by
# scripts/convert-new-jellycats.sh, then the originals live in img/jellycats/)
src/public/img/new/

# Camera originals dropped straight into img/. Only the derived webp
# (e.g. hero.webp) gets committed and published.
src/public/img/*.JPG

# Camera originals under src/img — huge (up to 230MB), never for git;
# GitHub rejects blobs over 100MB outright.
src/img/
